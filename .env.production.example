SMARTPROFIT_ENV=production
VITE_SUPABASE_URL=https://<production-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<production-publishable-key>
VITE_SUPABASE_PUBLISHABLE_KEY=<production-publishable-key>
VITE_AUTH_REDIRECT_URL=https://app.smartprofit.example.com

VITE_DATA_BACKEND=supabase
VITE_PRODUCTS_BACKEND=supabase
VITE_CUSTOMERS_BACKEND=supabase
VITE_SALES_BACKEND=supabase

SUPABASE_PROJECT_REF=<production-project-ref>
SUPABASE_CHECK_EMAIL=<production-healthcheck-user@example.com>
SUPABASE_CHECK_PASSWORD=<production-healthcheck-password>
SUPABASE_CHECK_BUSINESS_ID=<production-healthcheck-business-uuid>

# E2E should target staging by default. Only set these for controlled production smoke checks.
E2E_SMARTPROFIT_EMAIL=
E2E_SMARTPROFIT_PASSWORD=
E2E_SMARTPROFIT_BUSINESS_ID=

